# 主機上的 /opt/gym-system/.env（不進 git）。首次部署由 deploy.sh 以隨機值產生，之後只在主機上修改。
BASE_DOMAIN=sunkuo.cc

POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_PLATFORM_PASSWORD=

SECRET_KEY=
# Fernet 金鑰（32 bytes urlsafe base64）；換掉後健身房的 LINE 官方帳號金鑰就解不開，需重新輸入
DATA_ENCRYPTION_KEY=

# 平台管理後台 https://platform.<BASE_DOMAIN> 的第一個帳號（啟動時建立，不覆蓋已有密碼）
PLATFORM_ADMIN_USERNAME=ops
PLATFORM_ADMIN_PASSWORD=

# LINE 通知店家（ADR 0004），三個都留空＝不發送；Webhook：https://platform.<BASE_DOMAIN>/api/v1/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_BASIC_ID=
