# PostgreSQL（見 docs/adr/0001-multi-tenancy.md）：兩個帳號
# - 應用程式：受 RLS 限制，只有資料讀寫權限
DATABASE_URL=postgresql+psycopg://fitness_app:app_pw@localhost:5432/fitness_dev
# - migration／平台工具（python -m app.cli）：資料表擁有者
MIGRATION_DATABASE_URL=postgresql+psycopg://fitness_owner:owner_pw@localhost:5432/fitness_dev
APP_DB_ROLE=fitness_app
# - 平台管理後台：只能管理健身房清單、平台帳號與各家管理員帳號（docs/adr/0002-platform-console.md）
PLATFORM_DATABASE_URL=postgresql+psycopg://fitness_platform:platform_pw@localhost:5432/fitness_dev
PLATFORM_DB_ROLE=fitness_platform
# 平台管理後台網址：http://platform.<BASE_DOMAIN>
PLATFORM_SUBDOMAIN=platform

# 每家健身房一個子網域：<subdomain>.BASE_DOMAIN（本機：alpha.localhost）
BASE_DOMAIN=localhost
# 沒有子網域的網址（localhost:8000、IP）使用的健身房；正式環境請留空
DEFAULT_TENANT=demo

SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
